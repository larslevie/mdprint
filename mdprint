"""


def drop_font_fallback_warnings(lines):
    """Yields typst stderr lines minus "unknown font family" diagnostics.

    Fallback lists name fonts that are expected to be missing on some systems.
    A diagnostic runs from its header line through the next blank line.
    """
    skipping = False
    for line in lines:
        if line.startswith("warning: unknown font family"):
            skipping = True
        elif skipping and not line.strip():
            skipping = False
        elif not skipping:
            yield line


def open_pdfs(pdfs):
    opener = "open" if platform.system() == "Darwin" else "xdg-open"
    if not shutil.which(opener):
        print(f"mdprint: no '{opener}' to open the PDF(s)", file=sys.stderr)
        return
    # xdg-open takes a single file.
    for batch in ([pdfs] if opener == "open" else [[p] for p in pdfs]):
        subprocess.Popen([opener, *map(str, batch)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cups(*cmd):
    """Runs a CUPS query with untranslated output; None if it fails."""
    result = subprocess.run(cmd, capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"})
    return result.stdout if result.returncode == 0 else None


def parse_printers(lpstat_l_p):
    """Maps queue name -> description from `lpstat -l -p` output."""
    printers = {}
    queue = None
    for line in lpstat_l_p.splitlines():
        if m := re.match(r"printer (\S+) ", line):
            queue = m.group(1)
            printers[queue] = queue
        elif queue and (m := re.match(r"\s+Description: (.*\S)", line)):
            printers[queue] = m.group(1)
    return printers


def macos_last_used_printer():
    # Backs System Settings' "Last Printer Used", which CUPS doesn't see as a default.
    out = subprocess.run(["defaults", "export", "org.cups.PrintingPrefs", "-"], capture_output=True)
    if out.returncode != 0:
        return None
    try:
        prefs = plistlib.loads(out.stdout)
    except plistlib.InvalidFileException:
        return None
    recent = prefs.get("LastUsedPrinters") or [{}]
    return recent[0].get("PrinterID")


def match_printer(name, printers):
    """Finds the queue for NAME, given as a queue name or description, loosely."""
    if name in printers:
        return [name]
    squash = lambda s: re.sub(r"[^a-z0-9]", "", s.casefold())
    for same in (str.casefold, squash):
        exact = [q for q, d in printers.items() if same(name) in (same(q), same(d))]
        if exact:
            return exact
    return [q for q, d in printers.items() if squash(name) in squash(q) or squash(name) in squash(d)]


def resolve_printer(name):
    """Returns the queue to print to, or dies explaining why there is none."""
    listing = cups("lpstat", "-l", "-p")
    if listing is None:
        # Can't enumerate printers; let lp judge the name (or pick its default).
        return name
    printers = parse_printers(listing)
    available = "\n".join(f"  {d}" + (f"  ({q})" if d != q else "") for q, d in printers.items())
    if not printers:
        die("no printers are set up")
    if name:
        found = match_printer(name, printers)
        if len(found) == 1:
            return found[0]
        problem = f"'{name}' matches several printers" if found else f"no printer matches '{name}'"
        die(f"{problem}; available:\n{available}")

    default = cups("lpstat", "-d") or ""
    if m := re.match(r"system default destination: (\S+)", default):
        return m.group(1)
    if platform.system() == "Darwin" and (last := macos_last_used_printer()) in printers:
        return last
    if len(printers) == 1:
        return next(iter(printers))
    die(f"no default printer; pick one with -P, or set a default with 'lpadmin -d QUEUE':\n{available}")


def send_to_printer(pdf, args, job_title):
    cmd = ["lp", "-n", str(args.copies), "-t", job_title]
    if args.printer:
        cmd += ["-d", args.printer]
    if args.duplex:
        # Landscape pages flip like a book when bound on the paper's short edge.
        edge = "short" if args.landscape else "long"
        cmd += ["-o", f"sides=two-sided-{edge}-edge"]
    return subprocess.run(cmd + [str(pdf)]).returncode == 0


def collect_sources(path, recursive):
    """Returns the Markdown files at PATH, which may be a file or a directory."""
    if path.is_file():
        return [path]
    if not path.is_dir():
        die(f"no such file or directory: {path}")
    pattern = "**/*" if recursive else "*"
    found = [
        p for p in path.glob(pattern)
        if p.is_file() and p.suffix.lower() in MARKDOWN_SUFFIXES
        and not any(part.startswith(".") for part in p.relative_to(path).parts)
    ]
    if not found:
        hint = "" if recursive else " (use -r to include subdirectories)"
        die(f"no Markdown files in {path}{hint}")
    return sorted(found, key=lambda p: [part.lower() for part in p.relative_to(path).parts])


def render(src, pdf, args, workdir, style):
    """Compiles SRC to PDF; returns the front-matter title, or False on failure."""
    title, body = split_front_matter(src.read_text(encoding="utf-8"))
    workdir.mkdir()
    body_path = workdir / "body.md"
    body_path.write_text(BARE_ANCHOR.sub(r"<figure id=\1></figure>", body), encoding="utf-8")
    main = workdir / "main.typ"
    main.write_text(wrapper(style, body_path), encoding="utf-8")
    pdf.parent.mkdir(parents=True, exist_ok=True)

    inputs = {
        "base": str(src.parent),
        "paper": args.paper,
        "landscape": str(args.landscape).lower(),
        "highlight": str(args.highlight).lower(),
        "color": str(args.color).lower(),
        "link-footnotes": str(args.link_footnotes).lower(),
        "show-title": str(args.title).lower(),
        "filename": src.name,
    }
    if title:
        inputs["title"] = title
    cmd = ["typst", "compile", "--root", "/"]
    for k, v in inputs.items():
        cmd += ["--input", f"{k}={v}"]
    # Streamed so first-run package download progress shows as it happens.
    with subprocess.Popen(cmd + [str(main), str(pdf)], stderr=subprocess.PIPE, text=True) as proc:
        for line in drop_font_fallback_warnings(proc.stderr):
            sys.stderr.write(line)
    if proc.returncode != 0:
        print(f"mdprint: typst failed to compile {src}", file=sys.stderr)
        return False
    return title


def keep(pdfs, staging):
    """Moves PDFs out of STAGING in the temp dir so they survive its cleanup."""
    dest = Path(tempfile.mkdtemp(prefix="mdprint-"))
    moved = []
    for pdf in pdfs:
        target = dest / pdf.relative_to(staging)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(pdf, target)
        moved.append(target)
    return moved


def run(args, workdir):
    path = Path(args.file).expanduser().resolve()
    sources = collect_sources(path, args.recursive)
    batch = path.is_dir()

    if args.style:
        style = Path(args.style).expanduser().resolve()
        if not style.is_file():
            die(f"no such style file: {args.style}")
    else:
        style = workdir / "style.typ"
        style.write_text(STYLE, encoding="utf-8")

    # A directory's layout is mirrored, so same-named files can't collide.
    out = Path(args.output).expanduser().resolve() if args.output else None
    staging = workdir / "pdf"
    jobs = []
    for src in sources:
        rel = src.relative_to(path).with_suffix(".pdf") if batch else Path(f"{src.stem}.pdf")
        pdf = out if out and not batch else (out or staging) / rel
        jobs.append((src, pdf))

    # Render everything before printing anything, so a bad file can't leave a
    # half-printed set.
    titles = [render(src, pdf, args, workdir / f"build-{i}", style) for i, (src, pdf) in enumerate(jobs)]
    if False in titles:
        if not batch:
            sys.exit(1)
        failed = sum(t is False for t in titles)
        die(f"{failed} of {len(jobs)} file(s) failed to compile; nothing printed" if args.do_print
            else f"{failed} of {len(jobs)} file(s) failed to compile")

    pdfs = [pdf for _, pdf in jobs]
    if args.do_print:
        for n, ((src, pdf), title) in enumerate(zip(jobs, titles)):
            if not send_to_printer(pdf, args, title or src.name):
                unprinted = pdfs[n:] if out else keep(pdfs[n:], staging)
                die("printing failed; unprinted PDF(s) kept at:\n  " + "\n  ".join(map(str, unprinted)))
        if out:
            print("\n".join(map(str, pdfs)))
    else:
        if not out:
            # The viewer needs the PDFs after we exit, so they outlive the temp dir.
            pdfs = keep(pdfs, staging)
        print("\n".join(map(str, pdfs)))

    if args.open or (not args.do_print and not out):
        open_pdfs(pdfs)


def main(argv):
    args = parse_args(argv)
    if args.help:
        sys.stdout.write(HELP)
        return
    if args.print_style:
        sys.stdout.write(STYLE)
        return
    if not args.file:
        die("missing PATH\nTry 'mdprint --help'.", 2)
    if not shutil.which("typst"):
        die("typst not found; install it with: brew install typst")
    if args.do_print and not shutil.which("lp"):
        die("lp not found; printing needs CUPS (macOS has it; on Linux install cups-client)")
    if args.do_print:
        args.printer = resolve_printer(args.printer)

    # Turn SIGTERM/SIGHUP into SystemExit so the temp dir is removed on the way out.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _: sys.exit(128 + signum))
    try:
        with tempfile.TemporaryDirectory(prefix="mdprint-") as workdir:
            run(args, Path(workdir))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main(sys.argv[1:])
