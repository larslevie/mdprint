def die(msg, code=1):
    print(f"mdprint: {msg}", file=sys.stderr)
    sys.exit(code)


def parse_args(argv):
    p = argparse.ArgumentParser(prog="mdprint", add_help=False)
    p.add_argument("file", nargs="?")
    p.add_argument("-p", "--print", dest="do_print", action="store_true")
    p.add_argument("-P", "--printer")
    p.add_argument("-n", "--copies", type=int, default=1)
    p.add_argument("-d", "--duplex", action="store_true")
    p.add_argument("-o", "--output")
    p.add_argument("-r", "--recursive", action="store_true")
    p.add_argument("--title", action="store_true")
    p.add_argument("--open", action="store_true")
    p.add_argument("-s", "--style")
    p.add_argument("--paper", choices=["us-letter", "a4"], default="us-letter")
    p.add_argument("-l", "--landscape", action="store_true")
    p.add_argument("--link-footnotes", dest="link_footnotes", action="store_true", default=None)
    p.add_argument("--no-link-footnotes", dest="link_footnotes", action="store_false")
    p.add_argument("--highlight", action="store_true")
    p.add_argument("--color", action="store_true")
    p.add_argument("--print-style", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    p.error = lambda msg: die(f"{msg}\nTry 'mdprint --help'.", 2)
    args = p.parse_args(argv)
    if args.printer:
        args.do_print = True
    if args.link_footnotes is None:
        args.link_footnotes = args.do_print
    if args.copies < 1:
        die("--copies must be at least 1", 2)
    return args


def split_front_matter(text):
    """Returns (title or None, body) with any leading YAML front matter removed."""
    m = re.match(r"\A---[ \t]*\r?\n(.*?)\r?\n(?:---|\.\.\.)[ \t]*(?:\r?\n|\Z)", text, re.S)
    if not m:
        return None, text
    title = None
    for line in m.group(1).splitlines():
        t = re.match(r"title:\s*(.*?)\s*$", line)
        if t:
            title = t.group(1)
            if len(title) >= 2 and title[0] == title[-1] and title[0] in "\"'":
                title = title[1:-1]
            break
    return title or None, text[m.end():]


# cmarker crashes on <a> tags lacking href and only labels headings and figures
# by id, so empty <a id> anchors become empty figures to keep #id links valid.
BARE_ANCHOR = re.compile(r"<a\s+id=(\"[^\"]*\")\s*>\s*</a>", re.I)


def typst_str(s):
    # JSON escapes for quotes, backslashes and control chars are valid Typst.
    return json.dumps(s, ensure_ascii=False)


def wrapper(style_path, body_path):
    # Root is "/", so absolute host paths double as root-relative Typst paths.
    return f"""#import {typst_str(CMARKER)}: render
#import {typst_str(str(style_path))}: mdprint
#show: mdprint

#let base = sys.inputs.base
#let resolve(src) = if src.starts-with("/") {{ src }} else {{ base + "/" + src }}

#render(
  read({typst_str(str(body_path))}),
  scope: (image: (src, ..args) => image(resolve(src), ..args)),
